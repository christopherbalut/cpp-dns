[Unit]
Description=cpp-dns local fowarding DNS server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cpp_dns_app --bind 0.0.0.0 --port 53 --blocklist /etc/cpp-dns/blocklist.txt --workers 4
Restart=on-failure
RestartSec=2

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
